[connection]
id=Hotspot
uuid=0ae9327e-d3b5-47e0-9639-fe81716b2b3a
type=wifi
interface-name=wlan0
autoconnect=true

[wifi]
band=bg
mode=ap
ssid=WIFI_AP_SSID
channel=11
powersave=2
hidden=false

[wifi-security]
key-mgmt=wpa-psk
psk=WIFI_AP_PASSPHRASE

[ipv4]
address1=10.0.0.1/24,10.0.0.100
method=shared

[ipv6]
method=ignore

[proxy]