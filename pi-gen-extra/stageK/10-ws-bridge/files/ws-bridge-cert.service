# Creates the bridge's TLS certificate if there is no valid one yet (first boot, or after
# the files got truncated). The validity check lives in the script, so no Condition*= here.
[Unit]
Description=Generate TLS certificate for the Indiflight WebSocket bridge
Before=websocketd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/indiflight-bridge/ws-bridge-cert.sh

[Install]
WantedBy=multi-user.target
